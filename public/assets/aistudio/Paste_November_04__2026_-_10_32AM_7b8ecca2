<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RelatorPRO – Relatórios de Execução de Serviços</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="logo.js"></script>
  <!-- Cropper.js CDN para corte e zoom 1:1 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #1B2A3B;
      --navy-mid: #243447;
      --navy-light: #2E4260;
      --amber: #E8A020;
      --amber-light: #F5B93A;
      --green: #27AE60;
      --red: #E74C3C;
      --bg: #F0F3F7;
      --surface: #FFFFFF;
      --surface2: #F7F9FC;
      --border: #DDE3EC;
      --text: #1B2A3B;
      --text-muted: #6B7A8D;
      --mono: 'JetBrains Mono', monospace;
      --sans: 'Inter', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── HEADER PRINCIPAL ── */
    .app-header {
      background: var(--navy);
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0,0,0,.3);
    }
    .logo { display: flex; align-items: center; gap: 10px; }
    .logo-icon {
      width: 32px; height: 32px; background: var(--amber); border-radius: 6px;
      display: flex; align-items: center; justify-content: center; font-size: 16px;
    }
    .logo-text { font-size: 18px; font-weight: 700; color: #fff; letter-spacing: -.3px; }
    .logo-text span { color: var(--amber); }
    .header-actions { display: flex; gap: 10px; }

    .btn {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 7px;
      font-family: var(--sans); font-size: 13px; font-weight: 600; cursor: pointer; border: none; transition: all .15s; text-decoration: none;
    }
    .btn-ghost { background: rgba(255,255,255,.08); color: rgba(255,255,255,.85); border: 1px solid rgba(255,255,255,.12); }
    .btn-ghost:hover { background: rgba(255,255,255,.15); }
    .btn-amber { background: var(--amber); color: var(--navy); }
    .btn-amber:hover { background: var(--amber-light); }
    .btn-outline { background: transparent; color: var(--navy); border: 1.5px solid var(--border); }
    .btn-outline:hover { border-color: var(--amber); color: var(--amber); }
    .btn-danger { background: transparent; color: var(--red); border: 1.5px solid #f5c6c2; font-size: 12px; padding: 5px 10px; }
    .btn-danger:hover { background: #fff5f4; }

    /* ── TIMBRE NA INTERFACE DO FORMULÁRIO ── */
    .report-header-table {
      width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 20px; table-layout: fixed;
    }
    .report-header-table td { padding: 15px; vertical-align: middle; }
    .header-logo-col { width: 313px; min-width: 313px; max-width: 313px; text-align: center; border-right: 1px solid var(--border); background: var(--surface2); }
    .header-logo-col img { width: 283px; height: 80px; display: inline-block; vertical-align: middle; object-fit: contain; }
    .header-text-col { text-align: left; padding-left: 25px !important; }
    .header-company-title { color: #000080; font-size: 15px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 4px; text-transform: uppercase; }
    .header-company-cnpj { font-size: 13px; font-style: italic; font-weight: 600; color: #333; margin-bottom: 6px; }
    .header-company-details { font-size: 12px; color: #444; line-height: 1.5; font-weight: 500; }

    /* ── LAYOUT PRINCIPAL ── */
    .app-body { display: grid; grid-template-columns: 240px 1fr; min-height: calc(100vh - 60px); }
    .sidebar { background: var(--navy-mid); padding: 20px 0; position: sticky; top: 60px; height: calc(100vh - 60px); overflow-y: auto; }
    .sidebar-section { padding: 0 16px 20px; border-bottom: 1px solid rgba(255,255,255,.07); margin-bottom: 8px; }
    .sidebar-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,.35); padding: 8px 8px 10px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; cursor: pointer; color: rgba(255,255,255,.6); font-size: 13.5px; font-weight: 500; transition: all .15s; margin-bottom: 2px; }
    .nav-item:hover { background: rgba(255,255,255,.07); color: #fff; }
    .nav-item.active { background: var(--amber); color: var(--navy); }

    .progress-card { padding: 16px; color: #fff; }
    .progress-bar-wrap { background: rgba(255,255,255,0.1); height: 6px; border-radius: 3px; overflow: hidden; margin-bottom: 6px; }
    .progress-bar-fill { background: var(--amber); height: 100%; width: 0%; transition: width .3s; }
    .progress-pct { font-size: 12px; color: rgba(255,255,255,0.6); text-align: right; }

    .main { padding: 28px 32px; overflow-y: auto; }
    .section-page { display: none; }
    .section-page.active { display: block; }
    .page-header { margin-bottom: 24px; }
    .page-title { font-size: 22px; font-weight: 700; color: var(--navy); letter-spacing: -.4px; }

    .card { background: var(--surface); border-radius: 12px; border: 1px solid var(--border); padding: 22px 24px; margin-bottom: 18px; }
    .card-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }
    .card-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── FORMULÁRIOS ── */
    .field-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
    .field-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
    .field-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
    .field { display: flex; flex-direction: column; gap: 5px; }
    .field.span-2 { grid-column: span 2; }
    label { font-size: 11.5px; font-weight: 600; color: var(--text-muted); letter-spacing: .3px; text-transform: uppercase; }
    label .req { color: var(--red); margin-left: 2px; }

    input[type="text"], input[type="date"], input[type="time"], input[type="number"], select, textarea {
      font-family: var(--sans); font-size: 14px; color: var(--text); background: var(--surface2); border: 1.5px solid var(--border); border-radius: 8px; padding: 10px 12px; outline: none; width: 100%;
    }
    input:focus, select:focus, textarea:focus { border-color: var(--amber); box-shadow: 0 0 0 3px rgba(232,160,32,.12); background: #fff; }
    textarea { resize: vertical; min-height: 90px; }

    .radio-group { display: flex; gap: 16px; margin-top: 6px; }
    .radio-label { display: flex; align-items: center; gap: 6px; font-size: 13.5px; color: var(--text); cursor: pointer; }
    .radio-label input { width: 16px; height: 16px; accent-color: var(--amber); }

    /* ── TABELAS DE ITENS ── */
    .items-table { width: 100%; border-collapse: collapse; }
    .items-table th { text-align: left; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); padding: 10px 12px; background: var(--surface2); border-bottom: 2px solid var(--border); }
    .items-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 13.5px; vertical-align: middle; }
    .add-row-btn { background: transparent; color: var(--amber); border: 1.5px dashed var(--amber); padding: 10px; width: 100%; border-radius: 8px; font-weight: 600; font-size: 13px; cursor: pointer; margin-top: 12px; transition: all .2s; }
    .add-row-btn:hover { background: rgba(232,160,32,0.05); }

    /* ── ARQUIVOS IMAGENS / FOTOS (1:1 LIMPO) ── */
    .photo-zone { border: 2px dashed var(--border); border-radius: 10px; padding: 26px; text-align: center; cursor: pointer; background: var(--surface2); transition: border-color .2s; }
    .photo-zone:hover { border-color: var(--amber); background: #fff; }
    .photo-zone-icon { font-size: 28px; margin-bottom: 6px; }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 20px; margin-top: 18px; }
    .photo-item { position: relative; border-radius: 8px; overflow: hidden; background: transparent; display: flex; flex-direction: column; }
    .photo-item-img-wrap { width: 100%; aspect-ratio: 1/1; position: relative; background: #e8edf5; border-radius: 8px; overflow: hidden; }
    .photo-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .photo-remove { position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,.65); color: #fff; border: none; border-radius: 50%; width: 26px; height: 26px; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10; }
    .photo-remove:hover { background: var(--red); }
    .photo-caption-text { padding: 6px 2px 2px 2px; font-size: 12px; color: var(--text); background: transparent; line-height: 1.4; display: block; }

    /* ── CHECKLIST ── */
    .checklist { display: flex; flex-direction: column; gap: 10px; }
    .check-item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; background: var(--surface2); border-radius: 8px; border: 1.5px solid var(--border); cursor: pointer; }
    .check-item input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--green); flex-shrink: 0; cursor: pointer; }
    .check-item.checked { border-color: #a7e6c4; background: #f0fbf5; }

    /* ── TOAST & MODAIS ── */
    .toast { position: fixed; bottom: 28px; right: 28px; background: var(--navy); color: #fff; padding: 14px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 600; box-shadow: 0 8px 30px rgba(0,0,0,.25); transform: translateY(80px); opacity: 0; transition: all .3s; z-index: 999; display: flex; align-items: center; gap: 10px; pointer-events: none; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { background: var(--green); }
    .toast.error { background: var(--red); }
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 500; align-items: center; justify-content: center; padding: 24px; }
    .modal-overlay.open { display: flex; }
    .modal-box { background: var(--surface); border-radius: 16px; width: 100%; max-width: 640px; padding: 24px; }

    /* Modal do Cropper 1:1 */
    .cropper-container-box { width: 100%; height: 340px; background: #111; border-radius: 8px; overflow: hidden; margin-bottom: 14px; }
    .cropper-toolbar { display: flex; gap: 8px; justify-content: center; margin-bottom: 14px; }
  </style>
</head>
<body>

<header class="app-header">
  <div class="logo">
    <div class="logo-icon">📋</div>
    <div class="logo-text">Relator<span>PRO</span></div>
  </div>
  <div class="header-actions">
    <button class="btn btn-ghost" onclick="abrirModalHistorico()">🔍 Ver Histórico/Salvos</button>
    <button class="btn btn-ghost" onclick="openNewReport()">＋ Novo Relatório</button>
    <button class="btn btn-ghost" onclick="persistirRelatorioAtual()">💾 Salvar (BLOB)</button>
    <button class="btn btn-amber" onclick="generatePDF()">⬇ Exportar PDF</button>
  </div>
</header>

<div class="modal-overlay" id="historicoModal">
  <div class="modal-box" style="max-width: 800px; max-height: 85vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3>📋 Relatórios Salvos no Navegador</h3>
      <button class="btn btn-danger" style="padding: 4px 10px;" onclick="fecharModalHistorico()">Fechar ✕</button>
    </div>
    <table class="items-table">
      <thead>
      <tr>
        <th>Nº OS</th>
        <th>Cliente Mandante</th>
        <th>Último Salvamento</th>
        <th style="width: 180px; text-align: center;">Ações</th>
      </tr>
      </thead>
      <tbody id="historicoTableBody"></tbody>
    </table>
  </div>
</div>

<div class="app-body">
  <aside class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-label">Seções do Trabalho</div>
      <div class="nav-item active" onclick="showSection('identificacao', this)">🏢 Identificação</div>
      <div class="nav-item" onclick="showSection('poco', this)">🚰 Dados do Poço</div>
      <div class="nav-item" onclick="showSection('servicos', this)">⚙️ Serviços Executados</div>
      <div class="nav-item" onclick="showSection('materiais', this)">📦 Materiais Aplicados</div>
      <div class="nav-item" onclick="showSection('checklist', this)">✅ Checklist de Qualidade</div>
      <div class="nav-item" onclick="showSection('fotos', this)">📷 Registro Fotográfico</div>
      <div class="nav-item" onclick="showSection('ocorrencias', this)">⚠️ Ocorrências</div>
    </div>
    <div class="progress-card">
      <div class="progress-bar-wrap"><div class="progress-bar-fill" id="progressBar"></div></div>
      <div class="progress-pct" id="progressPct">0%</div>
    </div>
  </aside>

  <main class="main">
    <table class="report-header-table">
      <tr>
        <td class="header-logo-col">
          <img id="reportLogoPreview" alt="Grupo Geoeste">
        </td>
        <td class="header-text-col">
          <div class="header-company-title">Parecis Perfuração de Poços e Sondagens Ltda</div>
          <div class="header-company-details">
            CNPJ: 31.386.206/0001-25<br>
            End. Av. Los Angeles, 269 – Bairro Jardim Califórnia<br>
            Sorriso-MT / CEP 78894-183 / Fone: (65) 3624-1389 Celular: (65) 99972-3112<br>
            E-mail: diretoria.geo@geoeste.com.br
          </div>
        </td>
      </tr>
    </table>

    <div class="section-page active" id="page-identificacao">
      <div class="page-header"><div class="page-title">🏢 Identificação do Serviço</div></div>
      <div class="card">
        <div class="card-title">📄 Ordem de Serviço</div>
        <div class="field-grid cols-3">
          <div class="field"><label>Nº OS <span class="req">*</span></label><input type="text" id="numeroOS" placeholder="OS-2026-0001" oninput="updateProgress()"></div>
          <div class="field"><label>Data de Execução <span class="req">*</span></label><input type="date" id="dataExecucao" oninput="updateProgress()"></div>
          <div class="field">
            <label>Tipo de Serviço</label>
            <select id="tipoServico" onchange="updateProgress()">
              <option value="">Selecione…</option>
              <option>Manutenção Preventiva</option>
              <option>Manutenção Corretiva</option>
              <option>Manutenção Conjunto-Motobomba</option>
              <option>Limpeza Completa de Poço</option>
            </select>
          </div>
          <div class="field">
            <label>Status Final</label>
            <select id="statusOS">
              <option>Concluído</option>
              <option>Em andamento</option>
              <option>Pendente</option>
            </select>
          </div>
          <div class="field"><label>Contrato / Ref</label><input type="text" id="contrato" placeholder="Ex: CONT-2026-009"></div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">🏭 Dados do Cliente / Local do Poço</div>
        <div class="field-grid">
          <div class="field span-2"><label>Razão Social<span class="req">*</span></label><input type="text" id="clienteNome" placeholder="Razão social completa" oninput="updateProgress()"></div>
          <div class="field"><label>CNPJ / CPF</label><input type="text" id="clienteCNPJ" placeholder="00.000.000/0000-00"></div>
          <div class="field span-2"><label>Endereço do Poço <span class="req">*</span></label><input type="text" id="enderecoLocal" placeholder="Rua, número, bairro" oninput="updateProgress()"></div>
          <div class="field"><label>Cidade / UF</label><input type="text" id="cidadeUF" value="Sorriso - MT"></div>
          <div class="field"><label>Contato Local</label><input type="text" id="contatoLocal" placeholder="Responsável"></div>
          <div class="field"><label>Telefone</label><input type="text" id="telefoneContato" placeholder="(65) 99999-0000"></div>
        </div>
      </div>
    </div>

    <div class="section-page" id="page-poco">
      <div class="page-header"><div class="page-title">🚰 Informações Estruturais do Poço</div></div>
      <div class="card">
        <div class="card-title">📊 Dados do Poço</div>
        <div class="field-grid cols-3">
          <div class="field"><label>Poço (TAG)</label><input type="text" id="pocoId" placeholder="Ex: PT01"></div>
          <div class="field"><label>Profundidade</label><input type="text" id="pocoProfundidade" placeholder="Ex: 150m"></div>
          <div class="field"><label>Diâmetro (Ø)</label><input type="text" id="pocoDiametro" placeholder="Ex: 6 polegadas"></div>
          <div class="field"><label>Crivo</label><input type="text" id="pocoCrivo" placeholder="Ex: 120m"></div>
          <div class="field"><label>Nível Estático (NE)</label><input type="text" id="pocoNivelEstatico" placeholder="Ex: 24m"></div>
          <div class="field"><label>Nível Dinâmico (ND)</label><input type="text" id="pocoNivelDinamico" placeholder="Ex: 48m"></div>
          <div class="field"><label>Vazão Mensurada</label><input type="text" id="pocoVazao" placeholder="Ex: 15m³/h"></div>
          <div class="field"><label>Tubo Edutor</label><input type="text" id="pocoTuboEdutor" placeholder="Ex: Geomecânico"></div>
          <div class="field"><label>Eletrodo Superior</label><input type="text" id="pocoElSup" placeholder="Ex: 45m"></div>
          <div class="field"><label>Eletrodo Inferior</label><input type="text" id="pocoElInf" placeholder="Ex: 50m"></div>
          <div class="field span-2"><label>Coordenadas UTM</label><input type="text" id="pocoCoord" placeholder="Ex: X=241500, Y=8624000"></div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">⚡ Equipamentos Hidromecânicos</div>
        <div class="field-grid cols-2">
          <div class="field">
            <label>Conjunto Moto-Bomba (Modelo/Especificação)</label>
            <input type="text" id="equipMotobomba" placeholder="Ex: Submersa Ebara 5HP">
            <div class="radio-group">
              <label class="radio-label"><input type="radio" name="motobombaEstado" value="Usado" checked> Usado</label>
              <label class="radio-label"><input type="radio" name="motobombaEstado" value="Novo"> Novo</label>
            </div>
          </div>
          <div class="field">
            <label>Painel Elétrico (Especificação Técnica)</label>
            <input type="text" id="equipPainel" placeholder="Ex: Partida direta com disjuntor-motor">
            <div class="radio-group">
              <label class="radio-label"><input type="radio" name="painelEstado" value="Usado" checked> Usado</label>
              <label class="radio-label"><input type="radio" name="painelEstado" value="Novo"> Novo</label>
            </div>
          </div>
        </div>
      </div>
    </div> <!-- Fecho correto da div page-poco -->

    <div class="section-page" id="page-servicos">
      <div class="page-header"><div class="page-title">⚙️ Serviços Técnicos Realizados</div></div>
      <div class="card">
        <div class="card-title">📝 Memorial Descritivo</div>
        <div class="field">
          <label>Memorial Descritivo das Atividades <span class="req">*</span></label>
          <textarea id="descricaoGeral" rows="5" placeholder="Descreva a metodologia e desenvolvimento das atividades técnicas..." oninput="updateProgress()"></textarea>
        </div>
      </div>
      <div class="card">
        <div class="card-title">Equipe de Execução</div>
        <div class="card-body">
          <table class="items-table" id="equipeTable">
            <thead>
            <tr>
              <th style="width:40px">#</th>
              <th>Nome do Colaborador</th>
              <th>Função / Cargo</th>
              <th style="width:40px"></th>
            </tr>
            </thead>
            <tbody id="equipeBody"></tbody>
          </table>
          <button type="button" class="add-row-btn" onclick="addEquipeRow()">＋ Adicionar Colaborador</button>
        </div>
      </div>
      <div class="card">
        <div class="card-title">📋 Lista de Serviços Conduzidos</div>
        <table class="items-table" id="servicosTable">
          <thead>
          <tr>
            <th style="width:40px">#</th>
            <th>Descrição dos Serviços Conduzidos</th>
            <th style="width:90px">Qtd</th>
            <th style="width:140px">Status</th>
            <th style="width:40px"></th>
          </tr>
          </thead>
          <tbody id="servicosBody"></tbody>
        </table>
        <button class="add-row-btn" onclick="addServicoRow()">＋ Adicionar Serviço</button>
      </div>
    </div>

    <div class="section-page" id="page-materiais">
      <div class="page-header"><div class="page-title">📦 Materiais e Insumos Aplicados</div></div>
      <div class="card">
        <table class="items-table" id="materiaisTable">
          <thead>
          <tr>
            <th style="width:40px">#</th>
            <th>Descrição do Material</th>
            <th style="width:130px">Unidade</th>
            <th style="width:80px">Qtd</th>
            <th style="width:120px">Situação</th>
            <th style="width:40px"></th>
          </tr>
          </thead>
          <tbody id="materiaisBody"></tbody>
        </table>
        <button class="add-row-btn" onclick="addMaterialRow()">＋ Adicionar material</button>
      </div>
    </div>

    <div class="section-page" id="page-checklist">
      <div class="page-header"><div class="page-title">✅ Checklist de Conformidade</div></div>
      <div class="card">
        <div class="card-title">Avaliação Técnica Preventiva</div>
        <div class="checklist" id="checklistContainer"></div>
      </div>
    </div>

    <!-- SEÇÃO ÚNICA: REGISTRO FOTOGRÁFICO DE EVIDÊNCIAS -->
    <div class="section-page" id="page-fotos">
      <div class="page-header">
        <div class="page-title">📷 Registro Fotográfico de Evidências</div>
