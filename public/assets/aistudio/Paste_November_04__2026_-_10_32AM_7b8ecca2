<script>
  const DB_NAME = 'RelatorProDB';
  const DB_VERSION = 1;
  const STORE_NAME = 'relatorios';

  const state = {
    photos: [] // Lista única e unificada de fotos
  };
  let sigPads = {};
  let cropperInstance = null;

  function addEquipeRow() {
    const tbody = document.getElementById('equipeBody');
    const rowCount = tbody.children.length + 1;
    const tr = document.createElement('tr');

    tr.innerHTML = `
    <td>${rowCount}</td>
    <td><input type="text" placeholder="Nome do Colaborador"></td>
    <td><input type="text" placeholder="Ex: Técnico de Campo / Auxiliar"></td>
    <td><button type="button" class="btn btn-danger" style="padding:4px 8px;" onclick="this.closest('tr').remove(); reindex('equipeBody');">✕</button></td>
  `;
    tbody.appendChild(tr);
  }

  function initDB() {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);
      request.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'numeroOS' });
        }
      };
      request.onsuccess = (e) => resolve(e.target.result);
      request.onerror = (e) => reject('Erro no IndexedDB: ' + e.target.error);
    });
  }

  function base64ToBlob(base64Data) {
    if (!base64Data) return null;
    if (base64Data.startsWith('blob:')) return null;
    try {
      const partes = base64Data.split(';base64,');
      const contentType = partes[0].split(':')[1];
      const raw = window.atob(partes[1]);
      const rawLength = raw.length;
      const uInt8Array = new Uint8Array(rawLength);
      for (let i = 0; i < rawLength; ++i) { uInt8Array[i] = raw.charCodeAt(i); }
      return new Blob([uInt8Array], { type: contentType });
    } catch (e) { return null; }
  }

  async function persistirRelatorioAtual() {
    const osID = document.getElementById('numeroOS').value.trim();
    if (!osID) {
      showToast('⚠️ Defina um Número de O.S. para conseguir salvar!', 'error');
      return;
    }

    const convertArrayToBlobs = (arr) => arr.map(p => ({ caption: p.caption, blob: base64ToBlob(p.dataUrl) })).filter(x => x.blob !== null);

    const dadosRelatorio = {
      numeroOS: osID,
      dataSalvamento: new Date().toLocaleString('pt-BR'),
      identificacao: {
        dataExecucao: document.getElementById('dataExecucao').value,
        tipoServico: document.getElementById('tipoServico').value,
        statusOS: document.getElementById('statusOS').value,
        contrato: document.getElementById('contrato').value,
        clienteNome: document.getElementById('clienteNome').value,
        clienteCNPJ: document.getElementById('clienteCNPJ').value,
        enderecoLocal: document.getElementById('enderecoLocal').value,
        cidadeUF: document.getElementById('cidadeUF').value,
        contatoLocal: document.getElementById('contatoLocal').value,
        telefoneContato: document.getElementById('telefoneContato').value
      },
      poco: {
        id: document.getElementById('pocoId').value,
        profundidade: document.getElementById('pocoProfundidade').value,
        diametro: document.getElementById('pocoDiametro').value,
        crivo: document.getElementById('pocoCrivo').value,
        ne: document.getElementById('pocoNivelEstatico').value,
        nd: document.getElementById('pocoNivelDinamico').value,
        vazao: document.getElementById('pocoVazao').value,
        tubo: document.getElementById('pocoTuboEdutor').value,
        sup: document.getElementById('pocoElSup').value,
        inf: document.getElementById('pocoElInf').value,
        coord: document.getElementById('pocoCoord').value,
        motobomba: document.getElementById('equipMotobomba').value,
        motobombaEstado: document.querySelector('input[name="motobombaEstado"]:checked')?.value || 'Usado',
        painel: document.getElementById('equipPainel').value,
        painelEstado: document.querySelector('input[name="painelEstado"]:checked')?.value || 'Usado'
      },
      servicosText: document.getElementById('descricaoGeral').value,
      equipeRows: gatherTableInputs('equipeBody'),
      servicosRows: gatherTableInputs('servicosBody'),
      materiaisRows: gatherTableInputs('materiaisBody'),
      checklist: gatherChecklistStates(),
      ocorrencias: {
        ocorrencias: document.getElementById('ocorrencias').value,
        pendencias: document.getElementById('pendencias').value,
        recomendacoes: document.getElementById('recomendacoes').value,
        observacoes: document.getElementById('observacoesGerais').value
      },
      fotosBlob: convertArrayToBlobs(state.photos)
    };

    try {
      const db = await initDB();
      const transaction = db.transaction([STORE_NAME], 'readwrite');
      const store = transaction.objectStore(STORE_NAME);
      await new Promise((resolve, reject) => {
        const req = store.put(dadosRelatorio);
        req.onsuccess = () => resolve();
        req.onerror = (e) => reject(e.target.error);
      });
      showToast('💾 Relatório e evidências salvos no banco local (BLOB)!', 'success');
    } catch (error) {
      showToast('❌ Erro ao salvar dados estruturais locais.', 'error');
    }
  }

  function gatherTableInputs(bodyId) {
    return Array.from(document.querySelectorAll(`#${bodyId} tr`)).map(tr => {
      return Array.from(tr.querySelectorAll('input, select')).map(i => i.value);
    });
  }

  function gatherChecklistStates() {
    return Array.from(document.querySelectorAll('.check-item')).map(item => {
      return item.querySelector('input[type=checkbox]').checked;
    });
  }

  function formatDate(val) {
    if (!val) return '—';
    const p = val.split('-');
    return p.length === 3 ? `${p[2]}/${p[1]}/${p[0]}` : val;
  }

  function showSection(id, element) {
    document.querySelectorAll('.section-page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
    document.getElementById('page-' + id).classList.add('active');
    element.classList.add('active');
  }

  function updateProgress() {
    const reqs = ['numeroOS', 'dataExecucao', 'clienteNome', 'enderecoLocal', 'descricaoGeral'];
    let filled = 0;
    reqs.forEach(id => { if (document.getElementById(id)?.value.trim()) filled++; });
    const pct = Math.round((filled / reqs.length) * 100);
    document.getElementById('progressBar').style.width = pct + '%';
    document.getElementById('progressPct').textContent = pct + '%';
  }

  function addServicoRow() {
    const tbody = document.getElementById('servicosBody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
    <td>${tbody.children.length + 1}</td>
    <td><input type="text" placeholder="Ex: Substituição de motobomba e cabos elétricos"></td>
    <td><input type="number" value="1" style="width:70px;"></td>
    <td><select><option>Executado</option><option>Pendente</option><option>Cancelado</option></select></td>
    <td><button class="btn btn-danger" style="padding:4px 8px;" onclick="this.closest('tr').remove(); reindex('servicosBody');">✕</button></td>
  `;
    tbody.appendChild(tr);
  }

  function addMaterialRow() {
    const tbody = document.getElementById('materiaisBody');
    const rowCount = tbody.children.length + 1;
    const tr = document.createElement('tr');

    tr.innerHTML = `
    <td>${rowCount}</td>
    <td><input type="text" placeholder="Ex: Cabo Flexível 4mm"></td>
    <td><input type="text" placeholder="Ex: Metro" style="width:110px;"></td>
    <td><input type="number" value="1" style="width:70px;"></td>
    <td>
      <select>
        <option>Aplicado</option>
        <option>Pendente</option>
        <option>Cancelado</option>
      </select>
    </td>
    <td><button class="btn btn-danger" style="padding:4px 8px;" onclick="this.closest('tr').remove(); reindex('materiaisBody');">✕</button></td>
  `;
    tbody.appendChild(tr);
    updateProgress();
  }

  function reindex(id) {
    document.querySelectorAll(`#${id} tr`).forEach((tr, idx) => tr.children[0].textContent = idx + 1);
  }

  function initChecklists() {
    const items = [
      "Uso completo dos Equipamentos de Proteção Individual (EPIs)",
      "Sinalização e isolamento do perímetro de trabalho",
      "Verificação de aterramento e isolamento do painel elétrico",
      "Vedação hermética e proteção sanitária da boca do poço",
      "Limpeza, recolhimento e destinação adequada de resíduos e insumos"
    ];
    const container = document.getElementById('checklistContainer');
    container.innerHTML = '';
    items.forEach((txt, idx) => {
      const div = document.createElement('div');
      div.className = 'check-item';
      div.innerHTML = `
      <input type="checkbox" id="chk_${idx}" onchange="this.closest('.check-item').classList.toggle('checked', this.checked)">
      <label class="check-label" for="chk_${idx}" style="cursor:pointer; font-size:13.5px; width:100%;">${txt}</label>
    `;
      container.appendChild(div);
    });
  }

  // ═══════════════════════════════════════════════════════
  //  FLUXO UNIFICADO DE RECORTE 1:1, ZOOM E LEGENDA PRÉVIA
  // ═══════════════════════════════════════════════════════
  function triggerPhoto() {
    const inp = document.getElementById('photoInput');
    if (inp) inp.click();
  }

  function preparePhotoForCrop(inp) {
    if (!inp.files || inp.files.length === 0) return;
    const file = inp.files[0];

    const reader = new FileReader();
    reader.onload = (e) => {
      const imgPreview = document.getElementById('cropperImagePreview');
      imgPreview.src = e.target.result;
      document.getElementById('cropPhotoCaption').value = '';

      document.getElementById('cropModal').classList.add('open');

      if (cropperInstance) cropperInstance.destroy();

      cropperInstance = new Cropper(imgPreview, {
        aspectRatio: 1,
        viewMode: 1,
        dragMode: 'move',
        autoCropArea: 0.9,
        restore: false,
        guides: true,
        center: true,
        highlight: false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false
      });
    };
    reader.readAsDataURL(file);
    inp.value = '';
  }

  function cropperZoom(ratio) { if (cropperInstance) cropperInstance.zoom(ratio); }
  function cropperRotate(deg) { if (cropperInstance) cropperInstance.rotate(deg); }

  function closeCropModal() {
    document.getElementById('cropModal').classList.remove('open');
    if (cropperInstance) {
      cropperInstance.destroy();
      cropperInstance = null;
    }
  }

  function confirmCropPhoto() {
    if (!cropperInstance) return;

    const caption = document.getElementById('cropPhotoCaption').value.trim();
    if (!caption) {
      showToast('⚠️ Digite uma breve legenda para a foto antes de salvar!', 'error');
      return;
    }

    const croppedCanvas = cropperInstance.getCroppedCanvas({
      width: 800,
      height: 800,
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high'
    });

    const base64Data = croppedCanvas.toDataURL('image/jpeg', 0.88);
    const id = 'photo-' + Date.now() + '-' + Math.random().toString(36).slice(2);

    state.photos.push({ id, dataUrl: base64Data, caption });

    renderPhotoGridItem(id, base64Data, caption);
    closeCropModal();
    showToast('Evidência fotográfica adicionada com sucesso!', 'success');
  }

  function renderPhotoGridItem(id, dataUrl, caption) {
    const container = document.getElementById('photosContainer');
    const div = document.createElement('div');
    div.className = 'photo-item';
    div.id = id;
    div.innerHTML = `
    <div class="photo-item-img-wrap">
      <img src="${dataUrl}" alt="Evidência">
      <button class="photo-remove" title="Excluir foto" onclick="removePhoto('${id}')">✕</button>
    </div>
    <div class="photo-caption-text">
      <span>${caption}</span>
    </div>
  `;
    container.appendChild(div);
  }

  function removePhoto(id) {
    state.photos = state.photos.filter(p => p.id !== id);
    const el = document.getElementById(id);
    if (el) el.remove();
  }

  // ═══════════════════════════════════════════════════════
  //  EMISSÃO E ENGINE DO LAUDO PDF
  // ═══════════════════════════════════════════════════════
  async function generatePDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const navy = [27, 42, 59], amber = [232, 160, 32], white = [255, 255, 255], textMuted = [107, 122, 141], darkText = [27, 42, 59];
    const W = 210, M = 14;
    let y = 14;

    function drawTimbreHeader() {
      if (typeof logoBase64 !== 'undefined' && logoBase64) {
        try {
          const imgSrc = logoBase64.startsWith('data:') ? logoBase64 : 'data:image/png;base64,' + logoBase64;
          doc.addImage(imgSrc, 'PNG', M + 5, y + 9, 52.5, 14.7);
        } catch(e) {
          console.error('Erro ao adicionar logo no PDF:', e);
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(14);
          doc.text('GEOESTE', M + 12, y + 18);
        }
      }

      const centerX = M + 62 + ((W - M*2 - 62) / 2);
      doc.setTextColor(0, 0, 128); doc.setFont('helvetica', 'bold'); doc.setFontSize(10.5);
      doc.text('PARECIS PERFURAÇÃO DE POÇOS E SONDAGENS LTDA', centerX, y + 11, { align: 'center' });

      doc.setFont('helvetica', 'normal'); doc.setFontSize(8); doc.setTextColor(50, 50, 50);
      doc.text('CNPJ: 31.386.206/0001-52', centerX, y + 15, { align: 'center' });
      doc.text('End. Av. Los Angeles,269 – Bairro Jardim Califórnia', centerX, y + 19, { align: 'center' });
      doc.text('Sorriso-MT / CEP 78894-183 / Fone: (65) 3624-1389 Celular: (65) 99972-3112', centerX, y + 23, { align: 'center' });
      doc.text('E-mail: diretoria.geo@geoeste.com.br', centerX, y + 27, { align: 'center' });

      y += 38;
    }

    function addPage() { doc.addPage(); y = 14; drawTimbreHeader(); }

    function section(title) {
      if (y > 255) addPage();
      doc.setFillColor(...navy); doc.rect(M, y, W - M*2, 7.5, 'F');
      doc.setFillColor(...amber); doc.rect(M, y, 3, 7.5, 'F');
      doc.setTextColor(...white); doc.setFont('helvetica', 'bold'); doc.setFontSize(9);
      doc.text(title, M + 5, y + 5);
      y += 11;
    }

    function table2col(rows) {
      const colWidth = (W - M * 2) / 2; // Metade da página útil: 91 mm

      rows.forEach((row, i) => {
        if (y > 270) addPage();

        doc.setFillColor(i % 2 === 0 ? 245 : 252, i % 2 === 0 ? 247 : 254, i % 2 === 0 ? 250 : 255);
        doc.rect(M, y, W - M * 2, 6.5, 'F');

        // --- COLUNA 1 (Esquerda) ---
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(7.5);
        doc.setTextColor(...textMuted);
        doc.text(String(row[0]).toUpperCase(), M + 3, y + 4.2);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8.5);
        doc.setTextColor(...darkText);
        doc.text(String(row[1] || '—'), M + colWidth - 6, y + 4.2, { align: 'right' });

        // --- COLUNA 2 (Direita) ---
        if (row[2]) {
          const col2StartX = M + colWidth + 6;

          doc.setFont('helvetica', 'bold');
          doc.setFontSize(7.5);
          doc.setTextColor(...textMuted);
          doc.text(String(row[2]).toUpperCase(), col2StartX, y + 4.2);

          doc.setFont('helvetica', 'normal');
          doc.setFontSize(8.5);
          doc.setTextColor(...darkText);
          doc.text(String(row[3] || '—'), W - M - 4, y + 4.2, { align: 'right' });
        }

        y += 6.5;
      });
      y += 3;
    }

    function labelVal(lbl, val) {
      if (y > 260) addPage();
      doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(...textMuted); doc.text(lbl.toUpperCase(), M, y); y += 4;
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(...darkText);
      const lines = doc.splitTextToSize(val, W - M*2);
      lines.forEach(l => { if (y > 272) addPage(); doc.text(l, M, y); y += 4.8; });
      y += 1.5;
    }

    function renderField(label, val, xPos, yPos, maxW) {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(7.5);
      doc.setTextColor(...textMuted);
      doc.text(label.toUpperCase(), xPos, yPos);

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(8.5);
      doc.setTextColor(...darkText);
      const textVal = String(val || '—');
      const lines = doc.splitTextToSize(textVal, maxW);
      doc.text(lines, xPos, yPos + 4);

      return 4 + (lines.length * 3.8);
    }

    drawTimbreHeader();

    section('1. IDENTIFICAÇÃO DO SERVIÇO');
    table2col([
      ['Nº da OS', document.getElementById('numeroOS').value || '—', 'Tipo de Serviço', document.getElementById('tipoServico').value || '—'],
      ['Data Execução', formatDate(document.getElementById('dataExecucao').value), 'Status Final', document.getElementById('statusOS').value || '—'],
      ['Contrato / Ref', document.getElementById('contrato').value || '—', '', '']
    ]);

    // 2. CLIENTE E LOCAL
    section('2. CLIENTE E LOCAL');

    const cliente = document.getElementById('clienteNome').value || '—';
    const cnpj = document.getElementById('clienteCNPJ').value || '—';
    const endereco = document.getElementById('enderecoLocal').value || '—';
    const cidade = document.getElementById('cidadeUF').value || '—';
    const contato = document.getElementById('contatoLocal').value || '—';
    const telefone = document.getElementById('telefoneContato').value || '—';

    const col1X = M;
    const col2X = M + 95;
    const colWidth = (W - M * 2) / 2 - 5;

    let h1 = renderField('Cliente Mandante', cliente, col1X, y, colWidth);
    let h2 = renderField('CNPJ / CPF', cnpj, col2X, y, colWidth);
    y += Math.max(h1, h2) + 3;

    h1 = renderField('Endereço Técnico', endereco, col1X, y, colWidth);
    h2 = renderField('Cidade / UF', cidade, col2X, y, colWidth);
    y += Math.max(h1, h2) + 3;

    h1 = renderField('Contato Local', contato, col1X, y, colWidth);
    h2 = renderField('Telefone', telefone, col2X, y, colWidth);
    y += Math.max(h1, h2) + 5;

    section('3. INFORMAÇÕES DO POÇO');
    table2col([
      ['Poço (TAG)', document.getElementById('pocoId').value || 'N/I', 'Profundidade', document.getElementById('pocoProfundidade').value || 'N/I'],
      ['Diâmetro (Ø)', document.getElementById('pocoDiametro').value || 'N/I', 'Crivo', document.getElementById('pocoCrivo').value || 'N/I'],
      ['Nível Estático (NE)', document.getElementById('pocoNivelEstatico').value || 'N/I', 'Nível Dinâmico (ND)', document.getElementById('pocoNivelDinamico').value || 'N/I'],
      ['Vazão Mensurada', document.getElementById('pocoVazao').value || 'N/I', 'Tubo Edutor', document.getElementById('pocoTuboEdutor').value || 'N/I'],
      ['Eletrodo Superior', document.getElementById('pocoElSup').value || 'N/I', 'Eletrodo Inferior', document.getElementById('pocoElInf').value || 'N/I'],
      ['Coordenadas UTM', document.getElementById('pocoCoord').value || 'N/I', '', '']
    ]);

    const bombaEst = (document.querySelector('input[name="motobombaEstado"]:checked')?.value || 'Usado').toUpperCase();
    const painelEst = (document.querySelector('input[name="painelEstado"]:checked')?.value || 'Usado').toUpperCase();

    const textoBomba = document.getElementById('equipMotobomba').value.trim() || 'N/I';
    const textoPainel = document.getElementById('equipPainel').value.trim() || 'N/I';

    const valorFinalBomba = textoBomba !== 'N/I' ? `${textoBomba} - (${bombaEst})` : `N/I - (${bombaEst})`;
    const valorFinalPainel = textoPainel !== 'N/I' ? `${textoPainel} - (${painelEst})` : `N/I - (${painelEst})`;

    const posXValor = M + 50; 
    const larguraDisponivel = W - M - posXValor - 2;

    // CONJUNTO MOTO-BOMBA
    if (y > 270) addPage();
    doc.setFillColor(245, 247, 250);
    doc.rect(M, y, W - M * 2, 6.5, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(7.5);
    doc.setTextColor(...textMuted);
    doc.text('CONJUNTO MOTO-BOMBA', M + 3, y + 4.2);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8.5);
    doc.setTextColor(...darkText);
    const linesBomba = doc.splitTextToSize(valorFinalBomba, larguraDisponivel);
    doc.text(linesBomba[0], posXValor, y + 4.2);
    y += 6.5;

    // PAINEL ELÉTRICO
    if (y > 270) addPage();
    doc.setFillColor(255, 255, 255);
    doc.rect(M, y, W - M * 2, 6.5, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(7.5);
    doc.setTextColor(...textMuted);
    doc.text('PAINEL ELÉTRICO', M + 3, y + 4.2);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8.5);
    doc.setTextColor(...darkText);
    const linesPainel = doc.splitTextToSize(valorFinalPainel, larguraDisponivel);
    doc.text(linesPainel[0], posXValor, y + 4.2);
    y += 8.5;

    if (y > 240) addPage();
    section('4. EQUIPE DE EXECUÇÃO');

    const eqRows = Array.from(document.querySelectorAll('#equipeBody tr'));
    if (eqRows.length > 0) {
      doc.setFillColor(...navy);
      doc.rect(M, y, W - M*2, 6.5, 'F');
      doc.setTextColor(...white);
      doc.setFontSize(8);
      doc.text('#', M+2, y+4);
      doc.text('Nome do Profissional / Colaborador', M+12, y+4);
      doc.text('Função / Atribuição no Processo', M+110, y+4);
      y += 6.5;

      eqRows.forEach((tr, i) => {
        if (y > 270) addPage();
        const inps = tr.querySelectorAll('input');
        doc.setFillColor(i % 2 === 0 ? 245 : 255);
        doc.rect(M, y, W - M*2, 6, 'F');
        doc.setTextColor(...darkText);
        doc.setFont('helvetica', i === 0 ? 'bold' : 'normal');
        doc.text(String(i+1), M+2, y+4);
        doc.text(inps[0]?.value || '', M+12, y+4);
        doc.text(inps[1]?.value || '', M+110, y+4);
        y += 6;
      });
      y += 4;
    }

    addPage(); section('5. SERVIÇOS TÉCNICOS EXECUTADOS');
    const dg = document.getElementById('descricaoGeral').value; if (dg) labelVal('Memorial Descritivo das Atividades', dg);
    const sRows = Array.from(document.querySelectorAll('#servicosBody tr'));
    if (sRows.length > 0) {
      y += 2; doc.setFillColor(...navy); doc.rect(M, y, W - M*2, 6.5, 'F');
      doc.setTextColor(...white); doc.setFontSize(8); doc.text('#', M+2, y+4); doc.text('Descrição dos Serviços Conduzidos', M+10, y+4); doc.text('Qtd', M+132, y+4); doc.text('Status', M+152, y+4);
      y += 6.5;
      sRows.forEach((tr, i) => {
        if (y > 270) addPage();
        const inputs = tr.querySelectorAll('input, select');
        doc.setFillColor(i % 2 === 0 ? 245 : 255); doc.rect(M, y, W - M*2, 6, 'F'); doc.setTextColor(...darkText);
        doc.text(String(i+1), M+2, y+4); doc.text((inputs[0]?.value || '').substring(0, 55), M+10, y+4); doc.text(inputs[1]?.value || '1', M+132, y+4); doc.text((inputs[2]?.value || '').replace(/[✅⏳❌]/g,'').trim(), M+152, y+4);
        y += 6;
      });
      y += 4;
    }

    const mRows = Array.from(document.querySelectorAll('#materiaisBody tr'));
    if (mRows.length > 0) {
      if (y > 240) addPage();
      section('6. MATERIAIS APLICADOS NO PROCESSO');

      doc.setFillColor(...navy); doc.rect(M, y, W - M*2, 6.5, 'F');
      doc.setTextColor(...white); doc.setFontSize(8);
      doc.text('#', M+2, y+4);
      doc.text('Descrição do Material', M+10, y+4);
      doc.text('Unidade', M+100, y+4);
      doc.text('Qtd', M+135, y+4);
      doc.text('Situação', M+155, y+4);
      y += 6.5;

      mRows.forEach((tr, i) => {
        if (y > 270) addPage();
        const inps = tr.querySelectorAll('input');
        const sel = tr.querySelector('select');

        doc.setFillColor(i % 2 === 0 ? 245 : 255); doc.rect(M, y, W - M*2, 6, 'F'); doc.setTextColor(...darkText);
        doc.setFont('helvetica', 'normal');

        doc.text(String(i+1), M+2, y+4);
        doc.text(inps[0]?.value || '', M+10, y+4);
        doc.text(inps[1]?.value || '', M+100, y+4);
        doc.text(inps[2]?.value || '', M+135, y+4);
        doc.text(sel?.value || '', M+155, y+4);

        y += 6;
      });
      y += 6;
    }

    addPage(); section('7. CHECKLIST DE CONFORMIDADE E SEGURANÇA');
    document.querySelectorAll('.check-item').forEach((item) => {
      if (y > 272) addPage();
      const checked = item.querySelector('input[type=checkbox]')?.checked;
      const descText = item.querySelector('.check-label')?.textContent || '';
      doc.setFillColor(checked ? 242 : 255, checked ? 250 : 246, checked ? 244 : 246); doc.rect(M, y, W - M*2, 6, 'F');
      doc.setFillColor(checked ? 39 : 231, checked ? 174 : 76, checked ? 96 : 60); doc.rect(M, y, 2.5, 6, 'F');
      doc.setTextColor(...darkText); doc.setFont('helvetica', 'normal'); doc.setFontSize(8.5); doc.text((checked ? '✓ ' : '○ ') + descText, M + 5, y + 4);
      doc.setFont('helvetica', 'bold'); doc.setTextColor(checked ? 39 : 231, checked ? 174 : 76, checked ? 96 : 60); doc.text(checked ? 'CONCLUÍDO' : 'PENDENTE', W - M - 2, y + 4, { align: 'right' });
      y += 7;
    });

    if (document.getElementById('ocorrencias').value || document.getElementById('pendencias').value || document.getElementById('recomendacoes').value || document.getElementById('observacoesGerais').value) {
      addPage(); section('8. NARRATIVAS DE CAMPO E ANOMALIAS');
      ['ocorrencias', 'pendencias', 'recomendacoes', 'observacoesGerais'].forEach(id => {
        const v = document.getElementById(id).value; if (v) {
          const titleMap = { ocorrencias: 'Intercorrências de Percurso', pendencias: 'Trabalhos Remanescentes / Pendências', recomendacoes: 'Recomendações Geológicas Futuras', observacoesGerais: 'Notas Técnicas Gerais' };
          labelVal(titleMap[id], v);
        }
      });
    }

    // REGISTRO FOTOGRÁFICO DE EVIDÊNCIAS (1:1)
    if (state.photos.length > 0) {
      addPage();
      section('9. REGISTRO FOTOGRÁFICO DE EVIDÊNCIAS');

      const imgSize = 70;
      const colGap = 20;
      const captionSpace = 13;
      const verticalGap = 10;
      const blockTotalHeight = imgSize + captionSpace + verticalGap;

      const totalRowWidth = (imgSize * 2) + colGap;
      const startX = (W - totalRowWidth) / 2;

      let col = 0;
      let startRowY = y;

      for (let i = 0; i < state.photos.length; i++) {
        const p = state.photos[i];
        const posX = startX + col * (imgSize + colGap);

        if (startRowY + imgSize + captionSpace > 275) {
          addPage();
          startRowY = y;
          col = 0;
        }

        try {
          doc.addImage(p.dataUrl, 'JPEG', posX, startRowY, imgSize, imgSize);

          doc.setTextColor(40, 40, 40);
          doc.setFontSize(8);
          doc.setFont('helvetica', 'normal');

          const lines = doc.splitTextToSize(p.caption || '', imgSize);
          doc.text(lines.slice(0, 3), posX, startRowY + imgSize + 4);

        } catch(e) {
          console.error('Erro ao renderizar imagem no PDF:', e);
        }

        col++;
        if (col >= 2) {
          col = 0;
          startRowY += blockTotalHeight;
          y = startRowY;
        }
      }

      if (col > 0) {
        startRowY += blockTotalHeight;
        y = startRowY;
      }
      y += 2;
    }

    // RODAPÉ DINÂMICO
    const pgCount = doc.internal.getNumberOfPages();
    for (let i = 1; i <= pgCount; i++) {
      doc.setPage(i); doc.setFillColor(255,255,255); doc.rect(0, 286, W, 11, 'F');
      doc.setTextColor(160, 175, 195); doc.setFontSize(7.5); doc.setFont('helvetica', 'normal');
      doc.text('Parecis Perfuração de Poços e Sondagens Ltda | SORRISO-MT | Página ' + i + ' de ' + pgCount, W/2, 293, { align: 'center' });
    }

    doc.save(`Laudo-Tecnico-OS-${document.getElementById('numeroOS').value || 'PERSAN'}-${new Date().toISOString().slice(0,10)}.pdf`);
    showToast('✅ PDF exportado com sucesso!', 'success');
  }

  function openNewReport() { document.getElementById('newReportModal').classList.add('open'); }
  function closeNewReport() { document.getElementById('newReportModal').classList.remove('open'); }

  function resetForm() {
    document.querySelectorAll('input[type=text], input[type=date], input[type=time], input[type=number], textarea, select').forEach(el => { if (el.tagName === 'SELECT') el.selectedIndex = 0; else el.value = ''; });
    document.getElementById('servicosBody').innerHTML = '';
    document.getElementById('materiaisBody').innerHTML = '';
    document.getElementById('equipeBody').innerHTML = '';
    document.getElementById('photosContainer').innerHTML = '';
    state.photos = [];
    initChecklists();
    closeNewReport();
    showSection('identificacao', document.querySelector('.nav-item'));
    updateProgress();
  }

  function showToast(msg, type = '') { const t = document.getElementById('toast'); t.textContent = msg; t.className = 'toast ' + type + ' show'; setTimeout(() => t.classList.remove('show'), 3500); }

  document.addEventListener('DOMContentLoaded', () => {
    const logoImg = document.getElementById('reportLogoPreview');
    if (logoImg && typeof logoBase64 !== 'undefined') {
      logoImg.src = logoBase64.startsWith('data:') ? logoBase64 : "data:image/png;base64," + logoBase64;
    }

    initChecklists();
    updateProgress();

    const today = new Date().toISOString().slice(0, 10);
    ['dataExecucao'].forEach(id => { const el = document.getElementById(id); if (el && !el.value) el.value = today; });
    addServicoRow();
    addMaterialRow();
    addEquipeRow();
  });

  // HISTÓRICO INDEXEDDB
  async function abrirModalHistorico() {
    document.getElementById('historicoModal').classList.add('open');
    const tbody = document.getElementById('historicoTableBody');
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:20px;">Carregando histórico...</td></tr>';

    try {
      const db = await initDB();
      const transaction = db.transaction([STORE_NAME], 'readonly');
      const store = transaction.objectStore(STORE_NAME);
      const request = store.getAll();

      request.onsuccess = function(e) {
        const lista = e.target.result;
        if (!lista || lista.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:20px; color:var(--text-muted);">Nenhum relatório salvo encontrado neste navegador.</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        lista.forEach(relatorio => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
          <td style="font-weight:600;">${relatorio.numeroOS}</td>
          <td>${relatorio.identificacao?.clienteNome || '—'}</td>
          <td style="font-size:12px; color:var(--text-muted);">${relatorio.dataSalvamento || '—'}</td>
          <td style="text-align:center; display:flex; gap:6px; justify-content:center;">
            <button class="btn btn-amber" style="padding:5px 10px; font-size:11px;" onclick="carregarDadosNosCampos('${relatorio.numeroOS}', false)">📂 Abrir</button>
            <button class="btn btn-ghost" style="padding:5px 10px; font-size:11px; background:#2e4260; color:#fff;" onclick="carregarDadosNosCampos('${relatorio.numeroOS}', true)">📋 Copiar/Clonar</button>
          </td>
        `;
          tbody.appendChild(tr);
        });
      };
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:20px; color:var(--red);">Erro ao ler banco de dados local.</td></tr>';
    }
  }

  function fecharModalHistorico() {
    document.getElementById('historicoModal').classList.remove('open');
  }

  async function carregarDadosNosCampos(osKey, isClonagem = false) {
    try {
      const db = await initDB();
      const transaction = db.transaction([STORE_NAME], 'readonly');
      const store = transaction.objectStore(STORE_NAME);
      const request = store.get(osKey);

      request.onsuccess = function(e) {
        const dados = e.target.result;
        if (!dados) return;

        if (isClonagem) {
          document.getElementById('numeroOS').value = '';
          showToast('📋 Dados copiados! Defina um NOVO Número de OS e altere o que precisar.', 'success');
        } else {
          document.getElementById('numeroOS').value = dados.numeroOS || '';
          showToast('📂 Relatório recuperado com sucesso!', 'success');
        }

        document.getElementById('dataExecucao').value = dados.identificacao?.dataExecucao || '';
        document.getElementById('tipoServico').value = dados.identificacao?.tipoServico || '';
        document.getElementById('statusOS').value = dados.identificacao?.statusOS || 'Concluído';
        document.getElementById('contrato').value = dados.identificacao?.contrato || '';
        document.getElementById('clienteNome').value = dados.identificacao?.clienteNome || '';
        document.getElementById('clienteCNPJ').value = dados.identificacao?.clienteCNPJ || '';
        document.getElementById('enderecoLocal').value = dados.identificacao?.enderecoLocal || '';
        document.getElementById('cidadeUF').value = dados.identificacao?.cidadeUF || '';
        document.getElementById('contatoLocal').value = dados.identificacao?.contatoLocal || '';
        document.getElementById('telefoneContato').value = dados.identificacao?.telefoneContato || '';

        document.getElementById('pocoId').value = dados.poco?.id || '';
        document.getElementById('pocoProfundidade').value = dados.poco?.profundidade || '';
        document.getElementById('pocoDiametro').value = dados.poco?.diametro || '';
        document.getElementById('pocoCrivo').value = dados.poco?.crivo || '';
        document.getElementById('pocoNivelEstatico').value = dados.poco?.ne || '';
        document.getElementById('pocoNivelDinamico').value = dados.poco?.nd || '';
        document.getElementById('pocoVazao').value = dados.poco?.vazao || '';
        document.getElementById('pocoTuboEdutor').value = dados.poco?.tubo || '';
        document.getElementById('pocoElSup').value = dados.poco?.sup || '';
        document.getElementById('pocoElInf').value = dados.poco?.inf || '';
        document.getElementById('pocoCoord').value = dados.poco?.coord || '';
        document.getElementById('equipMotobomba').value = dados.poco?.motobomba || '';
        if (dados.poco?.motobombaEstado) {
          const rBomba = document.querySelector(`input[name="motobombaEstado"][value="${dados.poco.motobombaEstado}"]`);
          if (rBomba) rBomba.checked = true;
        }

        document.getElementById('equipPainel').value = dados.poco?.painel || '';
        if (dados.poco?.painelEstado) {
          const rPainel = document.querySelector(`input[name="painelEstado"][value="${dados.poco.painelEstado}"]`);
          if (rPainel) rPainel.checked = true;
        }

        document.getElementById('descricaoGeral').value = dados.servicosText || '';
        document.getElementById('ocorrencias').value = dados.ocorrencias?.ocorrencias || '';
        document.getElementById('pendencias').value = dados.ocorrencias?.pendencias || '';
        document.getElementById('recomendacoes').value = dados.ocorrencias?.recomendacoes || '';
        document.getElementById('observacoesGerais').value = dados.ocorrencias?.observacoes || '';

        // Tabela de Equipe
        const eqBody = document.getElementById('equipeBody');
        eqBody.innerHTML = '';
        if (dados.equipeRows) {
          dados.equipeRows.forEach(row => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
            <td>${eqBody.children.length + 1}</td>
            <td><input type="text" value="${row[1] || ''}"></td>
            <td><input type="text" value="${row[2] || ''}"></td>
            <td><button type="button" class="btn btn-danger" style="padding:4px 8px;" onclick="this.closest('tr').remove(); reindex('equipeBody');">✕</button></td>
          `;
            eqBody.appendChild(tr);
          });
        }

        // Tabela de Serviços
        const sBody = document.getElementById('servicosBody');
        sBody.innerHTML = '';
        if (dados.servicosRows) {
          dados.servicosRows.forEach(row => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
            <td>${sBody.children.length + 1}</td>
            <td><input type="text" value="${row[1] || ''}"></td>
            <td><input type="number" value="${row[2] || '1'}" style="width:70px;"></td>
            <td><select><option ${row[3]?.includes('Executado')?'selected':''}>Executado</option><option ${row[3]?.includes('Pendente')?'selected':''}>Pendente</option><option ${row[3]?.includes('Cancelado')?'selected':''}>Cancelado</option></select></td>
            <td><button class="btn btn-danger" style="padding:4px 8px;" onclick="this.closest('tr').remove(); reindex('servicosBody');">✕</button></td>
          `;
            sBody.appendChild(tr);
          });
        }

        // Tabela de Materiais
        const mBody = document.getElementById('materiaisBody');
        mBody.innerHTML = '';
        if (dados.materiaisRows) {
          dados.materiaisRows.forEach(row => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
            <td>${mBody.children.length + 1}</td>
            <td><input type="text" value="${row[1] || ''}"></td>
            <td><input type="text" value="${row[2] || ''}"></td>
            <td><input type="number" value="${row[3] || '1'}" style="width:70px;"></td>
            <td>
              <select>
                <option ${row[4]?.includes('Aplicado')?'selected':''}>Aplicado</option>
                <option ${row[4]?.includes('Pendente')?'selected':''}>Pendente</option>
                <option ${row[4]?.includes('Cancelado')?'selected':''}>Cancelado</option>
              </select>
            </td>
            <td><button class="btn btn-danger" style="padding:4px 8px;" onclick="this.closest('tr').remove(); reindex('materiaisBody');">✕</button></td>
          `;
            mBody.appendChild(tr);
          });
        }

        // Checklist
        if (dados.checklist) {
          dados.checklist.forEach((checkState, idx) => {
            const chkInput = document.getElementById(`chk_${idx}`);
            if (chkInput) {
              chkInput.checked = checkState;
              chkInput.closest('.check-item').classList.toggle('checked', checkState);
            }
          });
        }

        // Restaurar Fotos BLOB
        state.photos = [];
        document.getElementById('photosContainer').innerHTML = '';
        if (dados.fotosBlob) {
          dados.fotosBlob.forEach(f => {
            if (f.blob) {
              const url = URL.createObjectURL(f.blob);
              const id = 'photo-' + Date.now() + '-' + Math.random().toString(36).slice(2);
              state.photos.push({ id, dataUrl: url, caption: f.caption || '' });
              renderPhotoGridItem(id, url, f.caption || '');
            }
          });
        }

        updateProgress();
        fecharModalHistorico();
      };
    } catch (error) {
      showToast('❌ Erro ao ler dados do relatório selecionado.', 'error');
    }
  }

  // NAVEGAÇÃO SEQUENCIAL
  function avancarFluxo() {
    const navItems = Array.from(document.querySelectorAll('.sidebar .nav-item'));
    const currentIndex = navItems.findIndex(item => item.classList.contains('active'));

    if (currentIndex !== -1) {
      const nextIndex = (currentIndex + 1) % navItems.length;
      const nextItem = navItems[nextIndex];
      nextItem.click();
      window.scrollTo({ top: 0, behavior: 'smooth' });

      const btn = document.getElementById('btnProximoFluxo');
      if (nextIndex === navItems.length - 1) {
        btn.innerHTML = 'Voltar para o Início ↺';
      } else {
        btn.innerHTML = 'Próxima Seção ➔';
      }
    }
  }
</script>
